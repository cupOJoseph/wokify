{
  "name": "wokify",
  "version": "0.2.0",
  "description": "Inclusive language for Claude Code and Codex: guidance in CLAUDE.md and AGENTS.md, plus an Alex.js linter that checks what your agents write.",
  "type": "module",
  "bin": {
    "wokify": "bin/wokify.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./RULES.md": "./RULES.md"
  },
  "files": [
    "bin/",
    "lib/",
    "RULES.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "inclusive-language",
    "inclusive",
    "claude",
    "claude-code",
    "codex",
    "agents-md",
    "claude-md",
    "ai",
    "llm",
    "context",
    "alex",
    "alexjs",
    "linter",
    "lint",
    "hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cupOJoseph/wokify.git"
  },
  "homepage": "https://github.com/cupOJoseph/wokify#readme",
  "bugs": {
    "url": "https://github.com/cupOJoseph/wokify/issues"
  },
  "license": "MIT",
  "dependencies": {
    "alex": "11.0.1"
  }
}
